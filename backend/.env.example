# Base URL of your local Ollama instance (no trailing slash)
OLLAMA_HOST=http://localhost:11434
# Keep true for Ollama. Set false for LM Studio's OpenAI-compatible API.
LLM_USE_NATIVE_OLLAMA=true

# Optional: override the full chat endpoint directly instead of OLLAMA_HOST
# OLLAMA_URL=http://localhost:11434/api/chat

# Model to use when the frontend doesn't specify one
DEFAULT_MODEL=qwen3:8b

# Where chat history is stored
DATABASE_URL=sqlite+aiosqlite:///./localgpt.db

# Comma-separated list of allowed frontend origins. Use * for trusted LAN testing.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend bind address. Use BACKEND_HOST=0.0.0.0 for LAN access.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

DEBUG=false

# Ollama speed tuning
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
# Optional: set to your CPU thread count if you want to tune locally
# OLLAMA_NUM_THREAD=8
DEFAULT_MAX_TOKENS=1536
QWEN_MAX_TOKENS=1024

# Automatic web research
WEB_SEARCH_ENABLED=true
WEB_SEARCH_ALWAYS=false
WEB_SEARCH_CACHE_TTL=900
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_MAX_PAGES=3
