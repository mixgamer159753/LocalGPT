# Atomic Chat API origin. Its displayed base URL is http://127.0.0.1:1337/v1.
# Do not append /v1 here: LocalGPT adds the API paths automatically.
# Legacy OLLAMA_* names are also used for the Atomic Chat connection.
OLLAMA_HOST=http://127.0.0.1:1337
LLM_USE_NATIVE_OLLAMA=false

# Optional: override the full chat endpoint directly instead of OLLAMA_HOST
# OLLAMA_URL=http://127.0.0.1:1337/v1/chat/completions

# Optional preferred model ID. When blank, use the first model from the provider.
# Example: mradermacher/DeepSeek-V4-Pro-Qwen3_5-4B_Q8_0
DEFAULT_MODEL=

# Where chat history is stored
DATABASE_URL=sqlite+aiosqlite:///./localgpt.db

# Comma-separated list of allowed frontend origins. Use * for trusted LAN testing.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend bind address. Use BACKEND_HOST=0.0.0.0 for LAN access.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

DEBUG=false

# Output budget when the API request does not specify max_tokens.
# The frontend sends 16384 by default; provider limits still apply.
DEFAULT_MAX_TOKENS=1536

# Automatic web research
# auto: Exa when its key is present; otherwise Google/DDGS. Use exa to require Exa.
WEB_SEARCH_PROVIDER=auto
# Store your Exa key only in backend/.env or the backend process environment.
EXA_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_ALWAYS=false
WEB_SEARCH_CACHE_TTL=900
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_MAX_PAGES=3
# Maximum standard-research extract characters per source sent to the model.
# Deep research uses fuller extracts within a total 18,000-character budget.
WEB_SEARCH_CONTEXT_CHARS=1800
