# Optional full backend URL. Leave blank to use the current browser hostname.
# A browser override in the connection assistant takes precedence; reset it
# in the assistant to use this default again. Use only the FastAPI origin.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BACKEND_PORT=8000

# Comma-separated LAN hosts allowed to access Next.js dev resources.
# Example: NEXT_ALLOWED_DEV_ORIGINS=192.168.1.20
NEXT_ALLOWED_DEV_ORIGINS=
